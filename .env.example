# ==============================================================================
# Environment Configuration for Repo-Cartographer (Phase 1)
# Copy this file to .env and configure appropriate values
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & Secrets
# SECRET_KEY: Used for session JWT signing (min 32 chars recommended)
SECRET_KEY=change-this-secret-key-to-a-secure-random-value-in-production
# FERNET_KEY: Used for symmetric encryption of GitHub OAuth access tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
SESSION_COOKIE_NAME=rc_session
OAUTH_STATE_COOKIE_NAME=rc_oauth_state

# PostgreSQL with pgvector (Supports Neon URL with sslmode=require & pooler)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=repo_cartographer
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/repo_cartographer
# TEST_DATABASE_URL: Dedicated isolated database (e.g. separate Neon branch) used exclusively for integration tests.
# Destructive tests will strictly refuse to run if unset or equal to DATABASE_URL.
TEST_DATABASE_URL=

# Redis (accepts redis:// or rediss:// for hosted Redis like Upstash)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
# Seconds between ARQ worker queue polls (defaults to 5.0 to conserve hosted Redis commands quota)
ARQ_POLL_DELAY=5.0

# GitHub OAuth App Settings (Create at: https://github.com/settings/developers)
# Required scopes: read:user, user:email, repo
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Worker and Job Expiry Settings
# Seconds before an active non-expired job check considers an unattended job expired
JOB_EXPIRY_TIMEOUT_SECONDS=120

# GitHub Sync Limits
SYNC_MAX_COMMITS=500
SYNC_MAX_PRS=200
SYNC_MAX_ISSUES=500
SYNC_STATS_COMMITS_LIMIT=100
SYNC_STATS_PRS_LIMIT=50

# Phase 3: Code Intelligence, Embeddings & Indexing
EMBEDDING_PROVIDER=gemini # gemini | fake
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBED_BATCH_SIZE=16
EMBED_MAX_WAIT_SECONDS=600
EMBED_REQUESTS_PER_MINUTE=30
EMBED_MAX_CHARS_PER_REQUEST=10000
INDEX_MAX_FILES=1500
INDEX_MAX_FILE_BYTES=200000
INDEX_MAX_CHUNKS=1500
INDEX_MAX_REPO_DOWNLOAD_MB=100
DEMO_MODE=false

# Phase 4: Codebase Q&A (RAG) & Architecture Documentation
LLM_PROVIDER=gemini # gemini | fake
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
QA_TOP_K=8
QA_MAX_CONTEXT_CHARS=24000
QA_MAX_QUESTION_CHARS=1000
QA_RATE_LIMIT_PER_MINUTE=10
DOC_MAX_CONTEXT_CHARS=40000
DOC_MAX_OUTPUT_TOKENS=4096

# Phase 5: PR Analysis, Issue Classification & Test Generation
PR_ANALYSIS_MAX_FILES=30
PR_ANALYSIS_MAX_PATCH_CHARS=20000
PR_LARGE_DIFF_LINES=500
ISSUE_ANALYSIS_MAX_ISSUES=100
ISSUE_CLASSIFY_BATCH_SIZE=10
DUPLICATE_SIMILARITY_THRESHOLD=0.85
TESTGEN_MAX_SOURCE_CHARS=16000


